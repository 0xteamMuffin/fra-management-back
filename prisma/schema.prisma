generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  VillagePerson
  GramSabha
  SubDivisionalCommittee
  DistrictCommittee
}

enum FRAType {
  IFR
  CR
  CFR
}

enum ClaimStatus {
  Pending
  Verified
  Granted
  Rejected
}

enum AssetType {
  AgriculturalLand
  ForestCover
  WaterBody
  Homestead
  Infrastructure
}

enum SchemeStatus {
  Eligible
  Applied
  Approved
  Rejected
}

model State {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  districts District[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id          String        @id @default(uuid())
  name        String
  code        String?
  state       State         @relation(fields: [stateId], references: [id])
  stateId     String
  boundary    Unsupported("geometry")?
  subDistricts SubDistrict[]
  villages    Village[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SubDistrict {
  id         String    @id @default(uuid())
  name       String
  district   District  @relation(fields: [districtId], references: [id])
  districtId String
  villages   Village[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Village {
  id          String     @id @default(uuid())
  name        String
  district    District   @relation(fields: [districtId], references: [id])
  districtId  String
  subDistrict SubDistrict? @relation(fields: [subDistrictId], references: [id])
  subDistrictId String?
  coordinates Unsupported("geometry")
  boundary    Unsupported("geometry")?
  fraClaims   FRAClaim[]
  assets      AssetMap[]
  users       AppUser[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FRAClaim {
  id                  String    @id @default(uuid())
  type                FRAType // Retained for high-level classification
  claimantName        String
  spouseName          String?
  fatherOrMotherName  String?
  fullResidentialAddress String?
  villageName         String?
  gramPanchayat       String?
  tehsil              String?
  district            String?
  claimantCategory    String // "ST" or "OTFD"
  casteOrTribeCertificateS3Key String?

  // Section 2: Details of the Forest Right Claimed (as JSON for flexibility)
  claimedRights       Json?

  // Section 4: Additional Information
  otherRelevantInfo   String?
  applicantSignatureOrThumbS3Key String?
  remarks             String?

  // --- Core Claim Details ---
  status              ClaimStatus @default(Pending)
  currentStage        UserRole    @default(GramSabha)
  village             Village   @relation(fields: [villageId], references: [id])
  villageId           String

  // Relationships
  familyMembers       FamilyMember[]
  evidence            Evidence[]

  // --- Verification & Approval ---
  verifiedByUser      AppUser?    @relation("VerifiedClaims", fields: [verifiedByUserId], references: [id])
  verifiedByUserId    String?
  approvedByUser      AppUser?    @relation("ApprovedClaims", fields: [approvedByUserId], references: [id])
  approvedByUserId    String?
  grantedAt           DateTime?
  schemes             SchemeAssignment[]
  legacyDocs          LegacyDocument[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Link to the user who created the claim
  createdByUser    AppUser? @relation("CreatedClaims", fields: [createdByUserId], references: [id])
  createdByUserId  String?
}

model FamilyMember {
  id              String   @id @default(uuid())
  name            String
  age             Int
  relationship    String
  fraClaim        FRAClaim @relation(fields: [fraClaimId], references: [id])
  fraClaimId      String
  createdAt       DateTime @default(now())
}

model Evidence {
  id              String   @id @default(uuid())
  s3Key           String   // Link to the file in S3
  category        String   // e.g., "GovernmentRecords", "PhysicalEvidence"
  fraClaim        FRAClaim @relation(fields: [fraClaimId], references: [id])
  fraClaimId      String
  createdAt       DateTime @default(now())
}

model DocumentProcessing {
  id              String   @id @default(uuid())
  s3Key           String
  status          String   // "PENDING", "OCR_COMPLETE", "NER_COMPLETE", "FAILED"
  ocrEngineUsed   String?  // "Tesseract" or "GoogleVision"
  extractedText   String?  @db.Text
  structuredData  Json?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LegacyDocument {
  id         String @id @default(uuid())
  source     String
  s3FileLink String
  extracted  Boolean   @default(false)
  fraClaim   FRAClaim? @relation(fields: [fraClaimId], references: [id])
  fraClaimId String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model AssetMap {
  id          String    @id @default(uuid())
  village     Village   @relation(fields: [villageId], references: [id])
  villageId   String
  type        AssetType
  description Json?
  geoBoundary Unsupported("geometry")
  detectedAt  DateTime  @default(now())
}

model Scheme {
  id          String             @id @default(uuid())
  name        String
  ministry    String?
  description Json?
  eligibility Json?
  claims      SchemeAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model SchemeAssignment {
  id         String       @id @default(uuid())
  fraClaim   FRAClaim     @relation(fields: [fraClaimId], references: [id])
  fraClaimId String
  scheme     Scheme       @relation(fields: [schemeId], references: [id])
  schemeId   String
  status     SchemeStatus @default(Eligible)
  assignedAt DateTime     @default(now())
}

model AppUser {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(VillagePerson)
  phone          String?
  village        Village?   @relation(fields: [villageId], references: [id])
  villageId      String?
  verifiedClaims FRAClaim[] @relation("VerifiedClaims")
  approvedClaims FRAClaim[] @relation("ApprovedClaims")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  AuditLog       AuditLog[]
  createdClaims  FRAClaim[] @relation("CreatedClaims")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description Json?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String
}

model AuditLog {
  id        String   @id @default(uuid())
  user      AppUser? @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  timestamp DateTime @default(now())
  details   Json?
}
